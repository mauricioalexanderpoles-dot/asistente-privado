# Token que te da @BotFather. NUNCA lo subas al repositorio.
TELEGRAM_BOT_TOKEN=123456789:AAAA...

# IDs numéricos de Telegram autorizados, separados por comas.
# Déjalo vacío la primera vez: el bot rechazará tu mensaje y verás tu ID en los logs.
ALLOWED_USER_IDS=

LOG_LEVEL=INFO
DB_PATH=data/assistant.db
TIMEZONE=Europe/Madrid

# --- Fase 2: NLP + worker ---
OPENAI_API_KEY=sk-...
# Un modelo pequeño basta para extracción; comprueba en tu panel cuáles tienes disponibles
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT=30
WORKER_POLL_INTERVAL=5
WORKER_MAX_ATTEMPTS=5

# --- Fase 3: Google Calendar + Tasks ---
GOOGLE_CLIENT_SECRET_PATH=secrets/client_secret.json
GOOGLE_TOKEN_PATH=secrets/token.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_TASKLIST_ID=@default
GOOGLE_TIMEOUT=30
GOOGLE_OAUTH_PORT=8080
EVENTO_DURACION_MIN=60
